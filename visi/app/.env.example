# =============================================================================
# VISI Lab — Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# --- Database (shared by Wasp app + Keycloak) --------------------------------
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql://visi:changeme@localhost:5432/visi_lab

# --- Keycloak Admin Console ---------------------------------------------------
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=changeme
KEYCLOAK_HOSTNAME=auth.vaqueroisi.org
KEYCLOAK_PORT=8443

# --- Keycloak OIDC (used by Wasp app) ----------------------------------------
# After creating the "visi-lab" client in Keycloak, paste the secret here
KEYCLOAK_CLIENT_ID=visi-lab
KEYCLOAK_CLIENT_SECRET=paste-client-secret-here
KEYCLOAK_REALM_URL=https://auth.vaqueroisi.org/realms/visi

# --- App Settings -------------------------------------------------------------
ADMIN_EMAILS=your-email@example.com
INSTITUTIONAL_EMAIL_DOMAINS=utrgv.edu

# --- Optional: Stripe (leave blank to disable) --------------------------------
# STRIPE_API_KEY=sk_test_...

# --- Optional: AWS S3 (for file uploads) --------------------------------------
# AWS_S3_REGION=us-east-1
# AWS_S3_IAM_ACCESS_KEY=
# AWS_S3_IAM_SECRET_KEY=
# AWS_S3_FILES_BUCKET=
